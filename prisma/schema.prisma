// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  chats    Chat[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Chat {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("New Training Session")
  mode         String    @default("training") // "training" or "work"
  lastMessageAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat")
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_message")
}

// Purchase Order - Sales Order - Loading Slip Item Models

model PurchaseOrder {
  id           String   @id @default(cuid())
  poNumber     String   @unique
  customerName String
  customerId   String?
  status       String   @default("in-progress") // pending, in-progress, completed
  stage        Int      @default(1) // 1-6 workflow stages
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrders SalesOrder[]
  emails      Email[]
  customer    Customer? @relation(fields: [customerId], references: [id])
  bundles     Bundle[]

  @@map("purchase_order")
}

// One Bundle = one truck/vehicle worth of LoadingSlipItems. Computed from
// LoadingSlipItem.fileUrl-bearing rows in the PO via greedy first-fit
// packing against Customer.weightage (kg). A Bundle can contain LSIs from
// multiple SalesOrders within the same PO (per the bundling diagram).
model Bundle {
  id              String   @id @default(cuid())
  purchaseOrderId String
  bundleNumber    Int      // 1-based within the PO (B1, B2, …)
  totalWeightKg   Decimal  @default(0)
  status          String   @default("planned") // planned, invoiced, dispatched

  // Vehicle / transport details — one set per Bundle (per-truck), since
  // a bundle can carry LSIs from multiple SOs of the same PO.
  vehicleNumber   String?
  driverMobile    String?
  containerNumber String?
  transportId     String?
  sealNumber      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items         LoadingSlipItem[]
  materials     Material[]
  emails        Email[]
  shipments     Shipment[]

  @@unique([purchaseOrderId, bundleNumber])
  @@map("bundle")
}

// One Shipment per ZLOAD3-B1 request, keyed by (bundleId, salesOrderId).
// Maps 1:1 to the "HRJ Invoice Generated" + "Dispatch Document" boxes in the
// hierarchy diagram. SAP returns one OBD + one HRJ invoice per request, so
// they live here once per pair (not duplicated per LS). Per-LS fields like
// material_doc and loaded_quantity remain on LoadingSlipItem.
model Shipment {
  id                  String    @id @default(cuid())
  bundleId            String
  salesOrderId        String
  obdNumber           String?   // delivery_no — the Outbound Delivery / Dispatch Document
  invoiceNumber       String?   // invoice_no — the HRJ Invoice
  invoiceDate         DateTime?
  sapResults          String?   // JSON: full /processing-data rows for forensics
  status              String    @default("created") // created | shipment-triggered | shipped
  // Per-shipment Lorry Receipt — falls back to SalesOrder.lrNumber/lrDate
  // when null (back-compat for older Shipments + SO-wide LR scenarios).
  lrNumber            String?
  lrDate              DateTime?
  shipmentTriggeredAt DateTime?
  shippedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bundle     Bundle           @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  items      LoadingSlipItem[]

  @@unique([bundleId, salesOrderId])
  @@map("shipment")
}

// Customer record keyed by the externally-provided customer_id from the
// NEW ORDER email. Auto-created on first sight with a generic name.
// `weightage` is the customer's truck capacity in tonnes (default 45).
model Customer {
  id        String   @id
  name      String   @default("New Customer")
  weightage Decimal  @default(45)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@map("customer")
}

model SalesOrder {
  id                  String   @id @default(cuid())
  soNumber            String
  purchaseOrderId     String
  vehicleNumber       String?
  transportId         String?
  driverMobile        String?
  containerNumber     String?
  sealNumber          String?
  weight              Decimal?
  containerType       String?
  deliveryLocations   String?
  specialInstructions String?
  lrNumber            String?  // Lorry Receipt Number (Stage 5 - User Input)
  lrDate              DateTime? // Lorry Receipt Date (Stage 5 - User Input)
  originalThreadId    String?  // Gmail thread ID of the original "NEW ORDER" email
  originalMessageId   String?  // Gmail message ID of the original "NEW ORDER" email (for In-Reply-To)
  status              String   @default("pending") // pending, pending-input, in-progress, completed
  requiresInput       Boolean  @default(true)
  visibilityState     String?  // null | 'queued' | 'firing' | 'received' | 'failed' — drives serial ZSO-VISIBILITY for multi-SO POs
  visibilityRetries   Int      @default(0)
  // JSON release plan computed after branch reply intent (release_all / release_part):
  // [{material_code, batch, quantity, weight_kg}]. Held until weight gate clears.
  releasePlan         String?
  // For 'wait' branch reply intents: re-fire ZSO-VISIBILITY when this passes.
  waitUntil           DateTime?
  waitRechecks        Int       @default(0)
  // Denormalised latest scenarioKey from ScenarioProgress for fast dashboard reads.
  intentLabel         String?
  // SAP plant code (e.g. "7581"). Used to scope inventory pre-checks. Null →
  // fall back to SAP_DEFAULT_PLANT env var.
  plant               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items              LoadingSlipItem[]
  emails             Email[]
  invoice            Invoice?
  materials          Material[]
  workItems          WorkQueue[]
  shipments          Shipment[]
  shortages          MaterialShortage[]
  scenarioProgresses ScenarioProgress[]
  scenarioEvents     ScenarioEvent[]

  @@map("sales_order")
}

// One row per scenario RUN per SalesOrder. The unique constraint on
// salesOrderId was dropped in Phase E to support mid-flow re-entry: when a
// new reply supersedes an active scenario, we mark the old row 'aborted' and
// create a fresh row. The dashboard reads every row to show full audit
// history. The engine reads the most recent non-terminal row to find the
// "active" scenario.
model ScenarioProgress {
  id               String   @id @default(cuid())
  salesOrderId     String
  scenarioKey      String              // e.g. "branch|before_ls|modify|increase"
  currentStepIndex Int      @default(0)
  // 'ready' | 'awaiting_callback' | 'awaiting_reply'
  // | 'awaiting_plant_invoice' | 'awaiting_vt01n'
  // | 'completed' | 'aborted' | 'failed'
  state            String   @default("ready")
  classifierOutput String              // JSON of ScenarioSelection (or legacy BranchReplyClassification)
  triggerEmailId   String?
  lastWorkId       String?
  lastEmailId      String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesOrder       SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  events           ScenarioEvent[]

  @@index([salesOrderId, state])
  @@index([state, updatedAt])
  @@map("scenario_progress")
}

// Append-only chronological log of everything that happens to a SO inside
// the scenario engine. Used by:
//   - the dashboard to render a timeline
//   - the classifier to give the LLM mid-flow context (recent events)
// Types: email_received | classifier_decision | scenario_started | step_fired |
//        step_completed | email_sent | scenario_completed | scenario_aborted |
//        scenario_failed.
// `payload` is JSON whose shape depends on `type`.
model ScenarioEvent {
  id                 String   @id @default(cuid())
  salesOrderId       String
  scenarioProgressId String?
  type               String
  payload            String
  createdAt          DateTime @default(now())

  salesOrder         SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  scenarioProgress   ScenarioProgress? @relation(fields: [scenarioProgressId], references: [id], onDelete: SetNull)

  @@index([salesOrderId, createdAt])
  @@map("scenario_event")
}

// Global FIFO work queue. One row per pending /chat fire to auto_gui2.
// Invariant: at most one row in `state='firing'` at a time, system-wide.
// auto_gui2 acknowledges completion via POST /backend/orders/aman/step-status
// with the row's id as `work_id`. On failure, markFailed re-queues the row
// up to MAX_ATTEMPTS - 1 times with a backoff (see work-queue.ts). After
// MAX_ATTEMPTS the row stays failed.
model WorkQueue {
  id            String    @id @default(cuid())
  salesOrderId  String?
  step          String    // 'visibility' | 'zload1' | 'zload3b1' | 'vto1n' | 'mb51'
  payload       String    // JSON of the /chat body (so_number, instruction, attachments, etc.)
  state         String    @default("queued") // queued | firing | done | failed
  // Number of times this row has FAILED (and been retried). 0 = never failed.
  // When nextCount would equal MAX_ATTEMPTS, the row stays failed (terminal).
  attemptCount  Int       @default(0)
  // For backoff between retries. null = available now; set after a retry to
  // gate pumpQueue from re-firing too quickly. Cleared on terminal failure.
  nextAttemptAt DateTime?
  error         String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@map("work_queue")
}

// SO-level material visibility data returned by ZSO-VISIBILITY.
// Distinct from LoadingSlipItem (which is per-LS, created after ZLOAD1).
model Material {
  id                  String   @id @default(cuid())
  salesOrderId        String
  bundleId            String?
  material            String   // SAP material code
  materialDescription String?
  batch               String
  orderQuantity       Int
  availableStock      Int?     // available_stock_for_so
  orderWeightKg       Decimal? // order_weight_kg
  // Branch's selection for dispatch:
  //   null  = not yet decided
  //   0     = excluded (branch said skip / hold)
  //   >0    = release this many units
  dispatchQuantity    Int?
  // Set when dispatchQuantity is committed to a positive value via
  // persistDispatchPlan. Used by the FCFS shortage reactivator to subtract
  // our own outflow from the inflow pool — see shortage-reactivator.ts.
  releasedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  bundle     Bundle?    @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@unique([salesOrderId, material, batch])
  @@map("material")
}

model LoadingSlipItem {
  id           String  @id @default(cuid())
  salesOrderId String
  bundleId     String?
  shipmentId   String?
  lsNumber     String
  material     String
  status       String  @default("pending") // pending, in-progress, completed

  // Aman fields (read-only, populated via API later)
  materialDescription String?
  orderQuantity       Int?
  orderWeight         Decimal?
  grnNumber           String? // GRN Number (from Aman Stage 4)
  fileUrl             String? // R2 key for the LS file (XLS/PDF)

  // Per-LS SAP fields populated by /processing-data (ZLOAD3-B1 callback).
  // Material doc and loaded quantity legitimately vary per LS in a request.
  // (OBD and HRJ Invoice Number are per-request — those live on Shipment.)
  sapMaterialDoc      String?
  sapLoadedQuantity   Int?

  // User input fields (editable via forms)
  plantInvoiceNumber   String?   // Stage 3 - Plant Invoice Number
  plantInvoiceDate     DateTime? // Stage 3 - Plant Invoice Date
  invoiceQuantity      Int?      // Stage 3 - Invoice Quantity
  invoiceWeight        Decimal?  // Stage 3 - Invoice Weight
  receivedQuantity     Int?      // Stage 5 - Received Quantity
  receivedWeight       Decimal?  // Stage 5 - Received Weight
  deliveryStatus       String?   // Stage 5 - Delivery Status
  accountPayableStatus String?   // Stage 5 - Account Payable Status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  emails     Email[]
  bundle     Bundle?    @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  shipment   Shipment?  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@unique([lsNumber, material])
  @@map("loading_slip_item")
}

model Email {
  id                String    @id @default(cuid())
  salesOrderId      String?   // Direct link to SalesOrder (lead SO for combined dispatch emails)
  loadingSlipItemId String?   // Optional link to LoadingSlipItem (for LS-specific emails)
  purchaseOrderId   String?   // For multi-SO dispatch emails grouped under one PO
  bundleId          String?   // For per-bundle (per-truck) emails — vehicle details, etc.
  gmailMessageId    String    @unique // Gmail message ID for reply tracking
  gmailThreadId     String             // Thread ID to find replies
  recipientEmail    String
  subject           String
  status            String    @default("sent") // sent, replied, processed, queued, consumed
  sentAt            DateTime  @default(now())
  repliedAt         DateTime?
  replyPdfUrl       String?   // R2 key for the reply PDF attachment

  // Workflow fields
  emailType         String?   // 'ls_dispatch' | 'ls_dispatch_buffered' | 'production_inquiry' | 'production_reminder' | null (legacy)
  workflowState     String?   // 'awaiting_reply' | 'awaiting_production_reply' | 'waiting_timer' | 'awaiting_confirmation' | 'buffering' | 'completed' | null
  waitUntil         DateTime? // When to send reminder (set after production replies with days)
  relatedMaterials  String?   // JSON string of missing material codes
  sentBody          String?   // Plain text body of the sent email
  replyHtml         String?   // Reply body HTML (for forwarding to auto_gui2)

  // Supervisor-escalation tracking. When the unified classifier returns
  // action='other', the engine sends a `supervisor_inquiry` email and sets
  // `awaitingSupervisor=true` on the original trigger Email. `supervisorHops`
  // counts how many times this thread has bounced through supervisor review;
  // hard cap at 3 to prevent infinite loops on broken threads.
  awaitingSupervisor Boolean @default(false)
  supervisorHops     Int     @default(0)

  salesOrder      SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  loadingSlipItem LoadingSlipItem? @relation(fields: [loadingSlipItemId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  bundle          Bundle?          @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("email")
}

// Track incoming emails we've already processed (dedup for cron)
model ProcessedEmail {
  gmailMessageId String   @id
  gmailThreadId  String
  soNumbers      String?  // CSV list (1–4 SO numbers extracted from one NEW ORDER email)
  processedAt    DateTime @default(now())

  @@map("processed_email")
}

// Singleton table to track current SO being processed by Aman
model CurrentSO {
  soNumber String @id

  @@map("current_so")
}

// Per-material shortage snapshot recorded when branch replies 'wait'. The
// FCFS reactivator (driven by daily MB51) compares accumulated MaterialReceipt
// arrivals (postingDate >= recordedAt) against open shortages and re-fires
// ZSO-VISIBILITY for SOs whose every shortage is now covered. Append-only:
// resolution sets resolvedAt rather than deleting the row, so we keep history
// across multiple wait events for the same SO.
model MaterialShortage {
  id           String    @id @default(cuid())
  salesOrderId String
  material     String    // SAP code — material-level (sum across batches)
  shortQty     Int       // boxes still needed
  recordedAt   DateTime  @default(now())
  resolvedAt   DateTime?
  emailId      String?   // the branch-wait reply Email row that caused it

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, resolvedAt])
  @@index([recordedAt])
  @@map("material_shortage")
}

// One row per MB51 line item — daily goods-receipt feed for plant 7651.
// auto-gui2 runs MB51 at 11am IST and POSTs parsed rows to
// /backend/material-receipts/upload. Unique on (materialDocument, material,
// batch) so re-uploading the same posting date is idempotent.
model MaterialReceipt {
  id                  String   @id @default(cuid())
  materialDocument    String   // SAP MIGO doc (e.g. "5000000131")
  postingDate         DateTime // production day this receipt counts toward
  entryDate           DateTime // when posted in SAP
  material            String   // Y* SKU code
  materialDescription String?
  movementType        String   // typically "101"
  quantity            Int      // boxes
  batch               String
  baseUnit            String   @default("BOX")
  plant               String
  userName            String?
  documentHeaderText  String?
  timeOfEntry         String?  // "HH:MM:SS"
  purchaseOrder       String?  // SAP production order (5300000xxx)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([materialDocument, material, batch])
  @@index([postingDate])
  @@index([material])
  @@map("material_receipt")
}

model Invoice {
  id            String   @id @default(cuid())
  salesOrderId  String   @unique // ONE-TO-ONE with SO
  invoiceNumber String   // HRJ Invoice Number (from Aman Stage 4)
  obdNumber     String?  // Outbound Delivery Number (from Aman Stage 4)
  sapResults    String?  // JSON: raw ZSO_AUTO results [{sales_order, material_doc, delivery_no, invoice_no}]
  amount        Decimal?
  status        String   @default("pending") // pending, created, shipped

  // Shipment details (Stage 5 - User Input)
  shipmentType String?
  plantCode    String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("invoice")
}

// Free-stock snapshot synced from SAP every ~2 hours via auto_gui2. Upserted
// by (material, plant). Drives the stock pre-check that gates VA02 for
// increase-shaped modifications (replaces the old "Zmatana" SAP transaction).
model InventorySnapshot {
  id                  String   @id @default(cuid())
  material            String
  materialDescription String?
  vertical            String?
  plant               String
  freeStock           Int
  syncedAt            DateTime @default(now())

  @@unique([material, plant])
  @@index([material])
  @@map("inventory_snapshot")
}

// Singleton row tracking which CSV file label was last ingested, so we don't
// re-ingest the same file on every poll.
model InventorySyncState {
  id            String   @id @default("singleton")
  lastFileLabel String?
  lastSyncedAt  DateTime @updatedAt

  @@map("inventory_sync_state")
}
